{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "helpers:pinGitHubActionDigests"],
  enabledManagers: ["bun", "mise", "github-actions"],
  // No baseBranchPatterns on purpose (ADR-0008, METRO-61): Renovate reads this file only from the default branch and, without the option, processes only that branch, so it targets main after the cutover with no edit. scripts/cutover-plan.test.ts enforces it.
  rangeStrategy: "pin",
  // Must equal bunfig.toml install.minimumReleaseAge (259200 seconds); scripts/configuration.ts enforces it.
  minimumReleaseAge: "3 days",
  // Security fixes are not delayed by the cooldown.
  vulnerabilityAlerts: { minimumReleaseAge: null, rangeStrategy: "pin" },
  dependencyDashboard: true,
  prConcurrentLimit: 5,
  lockFileMaintenance: { enabled: true, schedule: ["before 5am on monday"] },
  packageRules: [
    { groupName: "react", matchPackageNames: ["react", "react-dom", "@types/react", "@types/react-dom"] },
    { groupName: "cloudflare", matchPackageNames: ["wrangler", "@cloudflare/**"] },
    { groupName: "oxc", matchPackageNames: ["oxfmt", "oxlint", "oxlint-tsgolint"] },
    // bun-types must equal the version @types/bun depends on (scripts/lint-config.test.ts checks it).
    { groupName: "bun types", matchPackageNames: ["bun-types", "@types/bun"] },
    { groupName: "typescript", matchPackageNames: ["typescript", "@typescript/**"] },
    { groupName: "playwright", matchPackageNames: ["playwright", "@playwright/**", "@axe-core/playwright"] },
  ],
}
