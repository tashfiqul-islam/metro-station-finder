{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "e2e/**/*.ts"],
      "project": ["scripts/**/*.ts", "e2e/**/*.ts"],
      "ignoreBinaries": ["mise", "renovate-config-validator"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/api": {
      "project": ["src/**/*.ts"]
    },
    "packages/contracts": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/core": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
