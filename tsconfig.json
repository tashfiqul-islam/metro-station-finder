{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Metro Station Finder — Next.js 15 / React 19",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable", "ESNext.AsyncIterable"],
    "module": "ESNext",
    "moduleResolution": "node",
    "moduleDetection": "auto",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "noEmit": true,
    "isolatedModules": true,
    "newLine": "lf",
    "useDefineForClassFields": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./*"],
      "@/app/*": ["./app/*"],
      "@/components/*": ["./app/_components/*"],
      "@/components/shared/*": ["./app/_components/shared/*"],
      "@/components/shared/cards/*": ["./app/_components/shared/cards/*"],
      "@/components/shared/buttons/*": ["./app/_components/shared/buttons/*"],
      "@/components/shared/effects/*": ["./app/_components/shared/effects/*"],
      "@/components/shared/ui/*": ["./app/_components/shared/ui/*"],
      "@/components/home/*": ["./app/_components/home/*"],
      "@/lib/*": ["./lib/*"],
      "@/hooks/*": ["./lib/hooks/*"],
      "@/types/*": ["./lib/types/*"],
      "@/utils/*": ["./lib/utils/*"],
      "@/styles/*": ["./styles/*"]
    },
    "typeRoots": ["types", "node_modules/@types"],
    "types": ["node", "react", "react-dom"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true
  },
  "include": [
    ".next/types/**/*.ts",
    "app/**/*",
    "components/**/*",
    "hooks/**/*",
    "lib/**/*",
    "next-env.d.ts",
    "styles/**/*",
    "types/**/*",
    "utils/**/*",
    "vitest.config.ts",
    "out/types/**/*.ts",
    "out\\dev/types/**/*.ts",
    ".next\\dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out",
    "dist",
    "build",
    "coverage",
    ".turbo",
    "scripts/**/*",
    "test/**/*",
    "**/*.{test,spec}.{ts,tsx}",
    "e2e/**/*",
    "playwright-report/**/*"
  ]
}
