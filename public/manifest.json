{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Metro Station Finder",
  "short_name": "MSF",
  "description": "Find the nearest Dhaka MRT-6 metro station and calculate fares. Offline-first PWA.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#0a0a0a",
  "background_color": "#ffffff",
  "lang": "en",
  "categories": ["navigation", "travel", "utilities"],
  "icons": [
    {
      "src": "/favicon.ico",
      "sizes": "64x64 32x32 24x24 16x16",
      "type": "image/x-icon"
    }
  ]
}
