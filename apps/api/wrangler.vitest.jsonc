{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Worker config for the Vitest workerd project only (ADR-0016). The real wrangler.jsonc gets its assets
  // directory from @cloudflare/vite-plugin, which the test pool does not run, so the directory is explicit
  // here. scripts/vitest-config.test.ts keeps compatibility_date and the assets routing equal to the real file.
  "name": "metro-scaffold-vitest",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "../web/public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/assets/*"],
  },
}
