{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "metro-scaffold",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "send_metrics": false,
  // `directory` is supplied by @cloudflare/vite-plugin (the client build output).
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Per-pull-request preview Workers: build with CLOUDFLARE_ENV=preview and deploy with --name
  // metro-scaffold-pr-<number>. Only previews are reachable on workers.dev; the default stays closed.
  "env": {
    "preview": {
      "name": "metro-scaffold-preview",
      "workers_dev": true,
      "preview_urls": false,
      "observability": { "enabled": true },
    },
  },
}
