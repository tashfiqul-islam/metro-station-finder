{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "metro-scaffold",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "send_metrics": false,
  // Production and preview each set every observability key explicitly instead of relying on inheritance
  // or platform defaults (METRO-43, docs/agents/observability.md). The app's own request line is the one log per request.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false },
  },
  // `directory` is supplied by @cloudflare/vite-plugin (the client build output).
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // /assets/* goes through the Worker only so a missing file is a 404, not the SPA index.html (ADR-0011).
    "run_worker_first": ["/api/*", "/assets/*"],
  },
  // Per-pull-request preview Workers: build with CLOUDFLARE_ENV=preview and deploy with --name
  // metro-scaffold-pr-<number>. Only previews are reachable on workers.dev; the default stays closed.
  "env": {
    "preview": {
      "name": "metro-scaffold-preview",
      "workers_dev": true,
      "preview_urls": false,
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "redact_query_string": true,
        "logs": { "invocation_logs": false },
        "traces": { "enabled": false },
      },
    },
  },
}
