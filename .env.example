# Metro Station Finder - Environment Variables Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# CLIENT-SIDE VARIABLES (Exposed to browser - prefixed with NEXT_PUBLIC_)
# =============================================================================

# Google Maps JavaScript API Key
# Get your key at: https://console.cloud.google.com/google/maps-apis
# Required in production, optional in development
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Application Configuration
NEXT_PUBLIC_APP_NAME=Metro Station Finder
NEXT_PUBLIC_APP_VERSION=1.0.0

# Google Analytics Measurement ID (optional)
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Disable maps functionality (useful for testing without API key)
# Options: true | false (default: false)
NEXT_PUBLIC_MAPS_DISABLED=false

# =============================================================================
# SERVER-SIDE VARIABLES (Only available on server - NOT exposed to browser)
# =============================================================================

# Node Environment
# Options: development | production | test
# Automatically set by Next.js, but can be overridden
NODE_ENV=development

# =============================================================================
# NOTES
# =============================================================================
# 
# Environment Variable Load Order (highest to lowest priority):
# 1. process.env
# 2. .env..local
# 3. .env.local (not loaded in test environment)
# 4. .env.
# 5. .env
#
# Files that should be in .gitignore:
# - .env.local (local overrides with real secrets)
# - .env.development.local
# - .env.production.local
# - .env.test.local
#
# Files that can be committed:
# - .env.example (this template file)
# - .env (base configuration, no real secrets)
# - .env.development (development defaults)
# - .env.production (production defaults)
# - .env.test (test configuration)
#
# For more information:
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables
