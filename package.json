{
  "name": "metro-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": { "node": "24.22.2", "bun": "1.4.0" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "bootstrap": "bun run scripts/tools.ts && bun install --frozen-lockfile",
    "dev": "bun run scripts/tools.ts && node scripts/dev.ts",
    "check": "bun run scripts/tools.ts && bun run scripts/boundaries.ts && bun test && tsc -p tsconfig.json && tsc -p packages/core/tsconfig.json",
    "build": "bun run scripts/tools.ts && bun run --cwd apps/web build && bun run --cwd apps/api build",
    "smoke": "bun run scripts/tools.ts && node scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.1",
    "typescript": "6.0.2",
    "vite": "8.3.5",
    "wrangler": "4.156.2"
  }
}
