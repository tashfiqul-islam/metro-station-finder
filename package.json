{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "metro-station-finder",
  "version": "1.0.0",
  "private": true,
  "description": "Find the nearest Dhaka MRT-6 metro station and calculate fares. PWA-ready, offline-first, zero-cost hosting on Cloudflare Workers.",
  "keywords": [
    "cloudflare-workers",
    "dhaka",
    "maplibre",
    "metro",
    "mrt-6",
    "pwa",
    "tanstack-start",
    "transit"
  ],
  "homepage": "https://github.com/tashfiqul-islam/metro-station-finder#readme",
  "bugs": {
    "url": "https://github.com/tashfiqul-islam/metro-station-finder/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Tashfiqul Islam",
    "url": "https://github.com/tashfiqul-islam"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tashfiqul-islam/metro-station-finder.git"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "start": "bun run dev",
    "typecheck": "tsc --noEmit",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:integration:watch": "vitest --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:install": "playwright install --with-deps",
    "test:e2e:report": "playwright show-report",
    "lighthouse": "lhci autorun",
    "lighthouse:collect": "lhci collect",
    "lighthouse:assert": "lhci assert",
    "commit": "cz",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "clean": "node -e \"for (const p of ['dist','.output','.tanstack','.nitro','coverage','playwright-report','test-results']) { try { require('node:fs').rmSync(p, { recursive: true, force: true }); } catch {} }\"",
    "reinstall": "node -e \"for (const p of ['node_modules','bun.lock']) { try { require('node:fs').rmSync(p, { recursive: true, force: true }); } catch {} }\" && bun install",
    "prepare": "lefthook install",
    "ci": "bun run typecheck && bun run lint:fix && bun run test && bun run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/oxanium": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-devtools": "^0.10.7",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.26",
    "@tanstack/router-plugin": "^1.168.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nitro": "^3.0.260610-beta",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.1",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/types": "^21.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tanstack/devtools-vite": "^0.8.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "commitizen": "^4.3.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "semantic-release": "^25.0.5",
    "shadcn": "^4.11.0",
    "typescript": "^6.0.3",
    "ultracite": "^7.8.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "lefthook",
    "msw"
  ]
}
