{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "metro-station-finder",
  "version": "1.0.0",
  "private": true,
  "description": "Find the nearest Dhaka MRT-6 metro station and calculate fares. PWA-ready, offline-first, zero-cost hosting on Cloudflare Workers.",
  "keywords": [
    "cloudflare-workers",
    "dhaka",
    "maplibre",
    "metro",
    "mrt-6",
    "pwa",
    "tanstack-start",
    "transit"
  ],
  "homepage": "https://github.com/tashfiqul-islam/metro-station-finder#readme",
  "bugs": {
    "url": "https://github.com/tashfiqul-islam/metro-station-finder/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Tashfiqul Islam",
    "url": "https://github.com/tashfiqul-islam"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tashfiqul-islam/metro-station-finder.git"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "start": "bun run dev",
    "typecheck": "tsc --noEmit",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "format": "ultracite fix",
    "format:check": "ultracite check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:integration:watch": "vitest --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:install": "playwright install --with-deps",
    "test:e2e:report": "playwright show-report",
    "lighthouse": "lhci autorun",
    "lighthouse:collect": "lhci collect",
    "lighthouse:assert": "lhci assert",
    "commit": "cz",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "clean": "rm -rf dist .output .tanstack .nitro coverage playwright-report test-results",
    "reinstall": "bun run clean && rm -rf node_modules bun.lock && bun install",
    "prepare": "lefthook install",
    "ci": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/oxanium": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-devtools": "^0.10.2",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-query-devtools": "^5.100.9",
    "@tanstack/react-router": "^1.169.1",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/react-router-ssr-query": "^1.166.12",
    "@tanstack/react-start": "^1.167.62",
    "@tanstack/router-plugin": "^1.167.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^12.38.0",
    "nitro": "^3.0.260429-beta",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.3.1",
    "web-vitals": "^5.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/types": "^20.5.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tanstack/devtools-vite": "^0.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "commitizen": "^4.3.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "semantic-release": "^25.0.3",
    "shadcn": "^4.6.0",
    "typescript": "^6.0.3",
    "ultracite": "^7.6.3",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.5"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22"
  },
  "packageManager": "bun@1.3.12",
  "trustedDependencies": [
    "lefthook",
    "msw"
  ]
}
