{
  "name": "metro-workspace",
  "private": true,
  "description": "Independent Metro rebuild workspace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "bootstrap": "bun run scripts/tools.ts && bun install --frozen-lockfile",
    "dev": "bun run scripts/tools.ts && node scripts/dev.ts",
    "build": "bun run scripts/tools.ts && bun run --cwd apps/web build && bun run --cwd apps/api build",
    "smoke": "bun run scripts/tools.ts && node scripts/smoke.ts",
    "typecheck": "tsc -p apps/web/tsconfig.json && tsc -p apps/api/tsconfig.json && tsc -p scripts/tsconfig.json && tsc -p tsconfig.test.json && tsc -p packages/core/tsconfig.json",
    "format": "node scripts/format.ts --write",
    "format:check": "node scripts/format.ts --check",
    "lint": "oxlint --type-aware --deny-warnings apps packages scripts",
    "scan": "bun run scan:dependencies && bun run scan:secrets",
    "imports:check": "bun run imports -- apps packages scripts",
    "check:fast": "bun run scripts/tools.ts && bun run format:check && bun run lint",
    "scan:secrets": "node scripts/secrets.ts",
    "bundle:check": "node scripts/bundle.ts",
    "scan:dependencies": "bun audit",
    "imports": "node --import ./scripts/dependency-parser.ts node_modules/dependency-cruiser/bin/dependency-cruiser.mjs --config .dependency-cruiser.mjs",
    "check": "bun run check:fast && bun run scripts/boundaries.ts && bun run imports:check && bun run unused && bun test && bun run typecheck",
    "unused": "knip"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261103.1",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/typescript6": "6.0.2",
    "dependency-cruiser": "18.7.2",
    "knip": "6.44.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.156.2"
  },
  "engines": {
    "bun": "1.4.4",
    "node": "26.13.0"
  },
  "packageManager": "bun@1.4.4"
}
