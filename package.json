{
  "name": "metro-station-finder",
  "version": "0.1.0",
  "description": "A modern metro station finder app for Dhaka with real-time fare calculation and Google Maps integration",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.22",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.2.0"
  },
  "author": {
    "name": "Tashfiqul Islam",
    "email": "tashfiqul.islam@example.com"
  },
  "license": "MIT",
  "homepage": "https://metro-station-finder.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/tashfiqul-islam/metro-station-finder.git"
  },
  "bugs": {
    "url": "https://github.com/tashfiqul-islam/metro-station-finder/issues"
  },
  "keywords": [
    "metro",
    "station-finder",
    "dhaka",
    "transportation",
    "nextjs",
    "typescript",
    "google-maps",
    "fare-calculator"
  ],
  "scripts": {
    "// === DEVELOPMENT ===": "",
    "dev": "next dev --turbopack",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "preview": "next start",
    "// === CODE QUALITY ===": "",
    "lint": "bunx ultracite@latest check",
    "format": "bunx ultracite@latest fix",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "type-check:scripts": "tsc --project tsconfig.scripts.json --noEmit",
    "// === TESTING ===": "",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "// === PROJECT MANAGEMENT ===": "",
    "clean": "bun run scripts/cleanup.mjs",
    "clean:all": "bun run scripts/cleanup.mjs && rm -rf node_modules",
    "setup": "bun run scripts/setup-dev.mjs",
    "fresh": "bun run clean:all && bun install && bun run setup",
    "validate": "bun run scripts/validate-project.mjs",
    "health": "bun run scripts/health-check.mjs",
    "// === DEPENDENCIES ===": "",
    "deps:update": "bun update",
    "deps:audit": "bun audit",
    "deps:check": "bun pm ls --outdated",
    "// === ANALYSIS & PERFORMANCE ===": "",
    "analyze": "ANALYZE=true bun run build",
    "perf:lighthouse": "bun run scripts/lighthouse.mjs",
    "// === RELEASE & DEPLOYMENT ===": "",
    "release": "bun run scripts/release.mjs",
    "release:patch": "bun run scripts/release.mjs patch",
    "release:minor": "bun run scripts/release.mjs minor",
    "release:major": "bun run scripts/release.mjs major",
    "// === GIT HOOKS ===": "",
    "hooks:install": "lefthook install",
    "precommit": "bun run format && bun run type-check && bun run test:run",
    "prepush": "bun run lint && bun run type-check && bun run test:run",
    "// === CI/CD ===": "",
    "ci": "bun run lint && bun run type-check && bun run test:run && bun run e2e",
    "// === UI COMPONENTS ===": "",
    "ui:add": "bunx shadcn@latest add",
    "ui:init": "bunx shadcn@latest init",
    "// === AI DEVELOPMENT TOOLS ===": "",
    "ai": "bun run scripts/ai-dev-tools.mjs",
    "ai:analyze": "bun run ai ai:analyze",
    "ai:fix": "bun run ai ai:fix",
    "// === UTILITIES ===": "",
    "dev-tools": "bun run scripts/dev-tools.mjs",
    "quick": "bun run dev-tools dev:full",
    "fix": "bun run dev-tools quality:fix",
    "ready": "bun run dev-tools git:ready"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@vis.gl/react-google-maps": "^1.5.5",
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "next-themes": "^0.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.63.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@next/bundle-analyzer": "^15.5.4",
    "@playwright/test": "^1.55.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^27.0.0",
    "lefthook": "^1.13.6",
    "postcss": "^8.5.6",
    "semantic-release": "^24.2.9",
    "shadcn": "^3.3.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "ultracite": "^5.4.6",
    "vitest": "^3.2.4"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "sharp"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "npx ultracite@latest fix"
    ],
    "*.{json,jsonc,md,mdx}": [
      "npx ultracite@latest fix"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "volta": {
    "node": "24.8.0",
    "bun": "1.2.22"
  },
  "release": {
    "branches": [
      "001-metro-station-finder"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/git",
      "@semantic-release/github"
    ],
    "tagFormat": "v${version}"
  }
}
