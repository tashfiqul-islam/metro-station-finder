{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "node",
    "react",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "eslint/eqeqeq": "error",
    "eslint/no-console": "error",
    "eslint/no-var": "error",
    "eslint/prefer-const": "error",
    "eslint/no-eval": "error",
    "eslint/no-implied-eval": "error",
    "eslint/no-return-assign": "error",
    "eslint/require-unicode-regexp": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/only-throw-error": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/no-useless-undefined": "error",
    "unicorn/prefer-string-replace-all": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "import/first": "error",
    "promise/no-return-wrap": "error",
    "promise/param-names": "error",
    "react/jsx-key": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    // The automatic JSX runtime (Vite, plugin-react, tsconfig `jsx: react-jsx`) needs no React import.
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": [
        "scripts/**",
        "e2e/**",
        "playwright.config.ts",
        "*.config.ts",
        ".dependency-cruiser.mts"
      ],
      "env": { "node": true },
      "rules": {
        // Command-line tools report through the console, and run their steps one after another on purpose
        // (Git, file and process work whose order matters).
        "eslint/no-console": "off",
        "eslint/no-await-in-loop": "off"
      }
    },
    {
      "files": ["apps/web/src/report-error.ts"],
      "rules": {
        // The one place the browser app writes to the console (METRO-58): it logs a fixed error class, never
        // a message, stack or component stack, and replaces React's default output, which prints the raw error.
        "eslint/no-console": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "plugins": [
        "eslint",
        "typescript",
        "unicorn",
        "oxc",
        "import",
        "promise",
        "node",
        "react",
        "jsx-a11y",
        "jest"
      ],
      "rules": {
        "eslint/no-console": "off",
        "eslint/no-await-in-loop": "off",
        // METRO-50 test hygiene. Oxlint's jest rules recognise only Jest/Vitest imports, so a file that imports
        // from "bun:test" is invisible to every jest/* rule (Repo-verified: oxlint 1.90.0; upstream oxc#23290).
        // Tests therefore use Bun's injected globals (typed by bun-types/test-globals) and this ban keeps it so.
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "bun:test",
                "message": "Use the injected test globals: the jest/* rules cannot see imports from bun:test."
              }
            ]
          }
        ],
        // Rules that reject a test which runs code without proving anything:
        // a test must assert (helpers that assert are listed), and never only in a branch or outside a test.
        "jest/expect-expect": ["error", { "assertFunctionNames": ["expect", "expectRejection"] }],
        "jest/no-conditional-expect": "error",
        "jest/no-standalone-expect": "error",
        // `expect(x, "message")` is Bun's documented custom failure message, so two arguments are valid.
        "jest/valid-expect": ["error", { "maxArgs": 2 }],
        // An un-awaited promise assertion never fails the test.
        "jest/valid-expect-in-promise": "error",
        // `toThrow()` passes on any error, including an unrelated one; the message pins the intended failure.
        "jest/require-to-throw-message": "error",
        // Tests that never run, or run alone and hide the rest of the suite.
        "jest/no-focused-tests": "error",
        "jest/no-disabled-tests": "error",
        "jest/no-test-prefixes": "error",
        "jest/no-commented-out-tests": "error",
        // Titles identify failures and distinguish tests.
        "jest/valid-title": "error",
        "jest/no-identical-title": "error",
        "jest/valid-describe-callback": "error",
        // A test file is not a module: exporting from it makes other files run its tests on import.
        "jest/no-export": "error",
        // Mistakes that make a test pass or hang for the wrong reason.
        "jest/no-done-callback": "error",
        "jest/no-duplicate-hooks": "error",
        "jest/no-unneeded-async-expect-function": "error",
        "jest/no-alias-methods": "error",
        // `toHaveBeenCalled()` alone does not show what the spy was called with.
        "jest/prefer-called-with": "error"
      }
    },
    {
      // VITEST_IMPORT_BAN_DIRECTORIES (METRO-80): the directories still run by `bun test`, where an import from
      // "vitest" fails confusingly at load time. Shrink "files" as ADR-0016 stages move scripts and packages onto
      // Vitest; apps/api and apps/web are never listed. An override replaces the rule config above for these
      // files, so the `bun:test` ban from the test override is repeated here and must stay in step with it.
      "files": ["scripts/**", "packages/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "bun:test",
                "message": "Use the injected test globals: the jest/* rules cannot see imports from bun:test."
              },
              {
                "name": "vitest",
                "message": "This directory still runs on `bun test`; a Vitest import fails there. Use the injected test globals."
              }
            ],
            "patterns": [
              {
                "group": ["@vitest/*"],
                "message": "This directory still runs on `bun test`; a Vitest import fails there."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    "apps/api/worker-configuration.d.ts",
    ".local/**",
    ".superpowers/**"
  ]
}
